{
  "name": "cinemux",
  "version": "0.1.0",
  "description": "Lecture des fichiers MKV dans un navigateur, par remux Matroska → fMP4. Sans WASM, sans transcodage.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "mkv",
    "matroska",
    "mp4",
    "remux",
    "mse",
    "media-source",
    "video"
  ]
}
