{
  "name": "cinemux",
  "version": "0.1.0",
  "description": "Play MKV files in a browser by remuxing Matroska to fragmented MP4 for MediaSource Extensions. No WASM, no transcoding, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "mkv",
    "matroska",
    "mp4",
    "fmp4",
    "remux",
    "remuxer",
    "mse",
    "media-source",
    "media-source-extensions",
    "isobmff",
    "video-player",
    "video",
    "webcodecs",
    "ac3",
    "h264",
    "hevc",
    "av1"
  ]
}
